generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  NONE
  STARTER
  PLUS
  MAX
}

enum JobStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  CUTTING
  DONE
  FAILED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  DUNNING
  CANCELED_GRACE
  CANCELED
}

enum BillingCycle {
  WEEKLY
  MONTHLY
}

enum PaymentSource {
  STRIPE
  TRIBUTE
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  VOIDED
}

enum WalletEntryKind {
  CREDIT
  DEBIT
}

enum WalletSource {
  REFERRAL
  AD_PARTNERSHIP
  ADJUSTMENT
  WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum JobStepName {
  DOWNLOAD
  TRANSCRIBE
  ANALYZE
  RENDER
  FINALIZE
}

enum JobStepStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AnalyzeEngine {
  LEGACY
  RECALL_CRITIC
}

enum NoClipsReason {
  NO_USABLE_SPEECH
  NO_VIABLE_MOMENTS
  PARTIAL_TRANSCRIPT
}

enum TelegramDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id                    String             @id @default(cuid())
  email                 String?            @unique
  emailVerified         DateTime?
  password              String?
  telegramId            String?            @unique
  telegramLocale        String?
  subtitlesEnabled      Boolean            @default(true)
  name                  String?
  image                 String?
  plan                  Plan               @default(NONE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  tributeSubscriptionId String?            @unique
  subscriptionStatus    SubscriptionStatus @default(NONE)
  billingCycle          BillingCycle?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  dunningSince          DateTime?
  graceEndsAt           DateTime?
  topUpMinutesRemaining   Int                @default(0)
  referralCode            String?            @unique
  referredById            String?
  referralTermsAcceptedAt DateTime?
  referralTermsVersion    String?
  referralBannedAt        DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  jobs                Job[]
  clips               Clip[]
  telegramDeliveries  TelegramDelivery[]
  telegramLinkTokens  TelegramLinkToken[]
  accounts            Account[]
  sessions            Session[]
  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]               @relation("Referrals")
  commissionsEarned   ReferralCommission[] @relation("ReferrerCommissions")
  commissionsCaused   ReferralCommission[] @relation("ReferredCommissions")
  walletEntries       WalletEntry[]
  withdrawalRequests  WithdrawalRequest[]
  tributeOrders       TributeOrder[]

  @@map("users")
}

model ReferralCommission {
  id                String           @id @default(cuid())
  referrerId        String
  referrer          User             @relation("ReferrerCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId    String
  referredUser      User             @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  source            PaymentSource
  externalPaymentId String
  originalCurrency  String
  originalAmount    Float
  exchangeRateToUsd Float
  grossAmountUsd    Float
  processorFeeUsd   Float
  taxUsd            Float            @default(0)
  discountUsd       Float            @default(0)
  refundUsd         Float            @default(0)
  netAmountUsd      Float
  rateBps           Int
  commissionUsd     Float
  status            CommissionStatus @default(PENDING)
  availableAt       DateTime
  adminNote         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([source, externalPaymentId])
  @@index([referrerId, status])
  @@index([status, availableAt])
  @@map("referral_commissions")
}

model WalletEntry {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      WalletEntryKind
  source    WalletSource
  amountUsd Float
  refType   String
  refId     String
  memo      String?
  createdAt DateTime        @default(now())

  @@unique([source, refType, refId])
  @@index([userId, createdAt])
  @@index([userId, source])
  @@map("wallet_entries")
}

model WithdrawalRequest {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsd             Float
  method                String
  destination           String
  requestedAvailableUsd Float
  networkFeeUsd         Float            @default(0)
  netAmountUsd          Float?
  status                WithdrawalStatus @default(PENDING)
  txRef                 String?
  adminNote             String?
  approvedBy            String?
  approvedAt            DateTime?
  paidBy                String?
  paidAt                DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("withdrawal_requests")
}

model TelegramLinkToken {
  code       String    @id
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([telegramId])
  @@index([expiresAt])
  @@map("telegram_link_tokens")
}

enum TributeWebhookStatus {
  RECEIVED
  PROCESSING
  APPLIED
  IGNORED
  FAILED
}

model TributeWebhookEvent {
  id          String               @id @default(cuid())
  eventHash   String               @unique
  name        String
  payload     Json
  status      TributeWebhookStatus @default(RECEIVED)
  outcome     String?
  attempts    Int                  @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([name, createdAt])
  @@index([status])
  @@map("tribute_webhook_events")
}

enum TributeOrderStatus {
  PENDING
  PAID
  DUNNING
  CANCELED
  FAILED
}

model TributeOrder {
  id           String             @id @default(cuid())
  orderUuid    String             @unique
  userId       String
  telegramId   String
  plan         Plan
  billingCycle BillingCycle
  amount       Int
  currency     String
  payUrl       String
  status       TributeOrderStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, plan, billingCycle, status])
  @@map("tribute_orders")
}

model StripeWebhookEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("stripe_webhook_events")
}

model Job {
  id                            String    @id @default(cuid())
  userId                        String
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl                     String?
  sourceKey                     String?
  originalFilename              String?
  status                        JobStatus @default(PENDING)
  error                         String?
  sourceDurationSec             Int?
  processingStartedAt           DateTime?
  processingEndedAt             DateTime?
  processingMs                  Int?
  transcribeMs                  Int?
  analyzeMs                     Int?
  renderMs                      Int?
  clipsGenerated                Int       @default(0)
  estimatedTranscriptionCostUsd Float?
  estimatedAnalysisCostUsd      Float?
  estimatedComputeCostUsd       Float?
  estimatedTotalCostUsd         Float?
  sourceArtifactKey             String?
  thumbnailKey                  String?
  transcriptJson                Json?
  renderManifest                Json?
  transcription                 String?   @db.Text
  highlights                    Json?
  subtitles                     Boolean   @default(true)
  language              String?
  languageRaw           String?
  noClipsReason         NoClipsReason?
  normalizedArtifactKey String?
  analyzeEngine         AnalyzeEngine?
  highlightsVersion     Int            @default(1)
  transcriptCoverage    Float?
  transcriptPartial     Boolean        @default(false)
  analysisInputTokens   Int?
  analysisOutputTokens  Int?
  createdAt                     DateTime  @default(now())

  clips            Clip[]
  steps            JobStep[]
  telegramDelivery TelegramDelivery?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("jobs")
}

model JobStep {
  id         String        @id @default(cuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step       JobStepName
  status     JobStepStatus @default(PENDING)
  attempt    Int           @default(0)
  inputJson  Json?
  outputJson Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([jobId, step])
  @@index([status, step])
  @@index([jobId])
  @@map("job_steps")
}

model TelegramDelivery {
  id          String                 @id @default(cuid())
  jobId       String                 @unique
  job         Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId      String
  status      TelegramDeliveryStatus @default(PENDING)
  error       String?
  deliveredAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("telegram_deliveries")
}

model Clip {
  id             String    @id @default(cuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  storageKey     String
  duration       Int
  startTime      Float
  endTime        Float
  subtitles      Boolean   @default(true)
  subtitleTrack  Json?
  description String?
  score       Float?
  language    String?
  lowQuality  Boolean @default(false)
  hookStart   Float? // source-absolute seconds, same timeline as startTime/endTime
  hookEnd     Float? // source-absolute seconds
  payoffAt    Float? // source-absolute seconds
  clipKind    String? // TS union ClipKind in shared types
  parentClipId   String?
  parentClip     Clip?     @relation("ClipRetrim", fields: [parentClipId], references: [id])
  retrims        Clip[]    @relation("ClipRetrim")
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([expiresAt, deletedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId, score(sort: Desc)])
  @@map("clips")
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
