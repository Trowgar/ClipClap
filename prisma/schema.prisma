generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  NONE
  STARTER
  PLUS
  MAX
}

enum JobStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  CUTTING
  DONE
  FAILED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  DUNNING
  CANCELED_GRACE
  CANCELED
}

enum BillingCycle {
  WEEKLY
  MONTHLY
}

enum PaymentSource {
  STRIPE
  TRIBUTE
}

enum CommissionStatus {
  PENDING
  AVAILABLE
  VOIDED
}

enum WalletEntryKind {
  CREDIT
  DEBIT
}

enum WalletSource {
  REFERRAL
  AD_PARTNERSHIP
  ADJUSTMENT
  WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum JobStepName {
  DOWNLOAD
  TRANSCRIBE
  ANALYZE
  RENDER
  FINALIZE
}

enum JobStepStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AnalyzeEngine {
  LEGACY
  RECALL_CRITIC
}

enum NoClipsReason {
  NO_USABLE_SPEECH
  NO_VIABLE_MOMENTS
  PARTIAL_TRANSCRIPT
}

enum TelegramDeliveryStatus {
  PENDING
  DELIVERED
  // The user was told the job failed. Not terminal: a stage writes Job.status
  // FAILED on every BullMQ attempt, so the job may still heal to DONE - and
  // then this row is picked up again and the clips are sent.
  FAILURE_NOTIFIED
  // The delivery itself threw (Telegram or R2). Terminal: re-running it would
  // duplicate whatever already reached the chat.
  FAILED
}

model User {
  id                    String             @id @default(cuid())
  email                 String?            @unique
  emailCanonical        String?            @unique
  emailVerified         DateTime?
  /// When a verification mail was last handed to the provider WITHOUT error.
  ///
  /// NULL means "we have no record of a link reaching this mailbox" - either
  /// the send failed, or the row predates this column. It is deliberately not a
  /// boolean and deliberately not set when the token is merely issued: the
  /// dashboard used to state "We sent you a link when you signed up"
  /// unconditionally, which is a lie every time Resend is down, over quota or
  /// bouncing, and it left the user waiting for mail that was never sent.
  verificationSentAt    DateTime?
  password              String?
  telegramId            String?            @unique
  telegramLocale        String?
  subtitlesEnabled      Boolean            @default(true)
  supportOpen           Boolean            @default(false)
  name                  String?
  image                 String?
  plan                  Plan               @default(NONE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  tributeSubscriptionId String?            @unique
  subscriptionStatus    SubscriptionStatus @default(NONE)
  billingCycle          BillingCycle?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  dunningSince          DateTime?
  graceEndsAt           DateTime?
  topUpMinutesRemaining   Int                @default(0)
  referralCode            String?            @unique
  referredById            String?
  referralTermsAcceptedAt DateTime?
  referralTermsVersion    String?
  referralBannedAt        DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  jobs                Job[]
  clips               Clip[]
  telegramDeliveries  TelegramDelivery[]
  telegramLinkTokens  TelegramLinkToken[]
  accounts            Account[]
  sessions            Session[]
  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]               @relation("Referrals")
  commissionsEarned   ReferralCommission[] @relation("ReferrerCommissions")
  commissionsCaused   ReferralCommission[] @relation("ReferredCommissions")
  walletEntries       WalletEntry[]
  withdrawalRequests  WithdrawalRequest[]
  tributeOrders       TributeOrder[]
  freeUsage           FreeUsage[]

  @@map("users")
}

model ReferralCommission {
  id                String           @id @default(cuid())
  referrerId        String
  referrer          User             @relation("ReferrerCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId    String
  referredUser      User             @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  source            PaymentSource
  externalPaymentId String
  originalCurrency  String
  originalAmount    Float
  exchangeRateToUsd Float
  grossAmountUsd    Float
  processorFeeUsd   Float
  taxUsd            Float            @default(0)
  discountUsd       Float            @default(0)
  refundUsd         Float            @default(0)
  netAmountUsd      Float
  rateBps           Int
  commissionUsd     Float
  status            CommissionStatus @default(PENDING)
  availableAt       DateTime
  adminNote         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([source, externalPaymentId])
  @@index([referrerId, status])
  @@index([status, availableAt])
  @@map("referral_commissions")
}

model WalletEntry {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      WalletEntryKind
  source    WalletSource
  amountUsd Float
  refType   String
  refId     String
  memo      String?
  createdAt DateTime        @default(now())

  @@unique([source, refType, refId])
  @@index([userId, createdAt])
  @@index([userId, source])
  @@map("wallet_entries")
}

model WithdrawalRequest {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountUsd             Float
  method                String
  destination           String
  requestedAvailableUsd Float
  networkFeeUsd         Float            @default(0)
  netAmountUsd          Float?
  status                WithdrawalStatus @default(PENDING)
  txRef                 String?
  adminNote             String?
  approvedBy            String?
  approvedAt            DateTime?
  paidBy                String?
  paidAt                DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("withdrawal_requests")
}

model TelegramLinkToken {
  code       String    @id
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([telegramId])
  @@index([expiresAt])
  @@map("telegram_link_tokens")
}

/// Funnel steps for both surfaces, which were previously invisible.
///
/// A User row only exists once someone presses "New account" or "Link
/// account", so everyone who opened the bot, read the first screen and left
/// was recorded nowhere. One row per person per step, not one per press - the
/// question is "how many people", so count(*) is the answer directly and the
/// table stays the size of the audience rather than of the traffic. Repeat
/// presses increment `occurrences`.
///
/// Deliberately NOT related to User: the whole point is the people who never
/// became one. Join on `subjectId` when you want the ones who did - it holds a
/// telegramId for surface='bot' and a users.id for surface='web'.
model FunnelEvent {
  /// "bot" | "web". Plain String for the same reason `event` is: adding a
  /// surface must not be a migration on a table nobody's request path needs.
  surface     String
  /// bot: telegramId (may predate the account). web: users.id (post-signup
  /// only - an anonymous visitor cannot be identified without cookies, which
  /// this product deliberately does not set).
  subjectId   String
  id          String   @id @default(cuid())
  /// Funnel step. Values come from FUNNEL_EVENTS in
  /// packages/shared/src/services/funnel.service.ts - a String, not an enum.
  event       String
  /// Locale as detected at the time. Copy exists in EN and RU only, so knowing
  /// what the drop-offs actually read is the one dimension worth a column.
  locale      String?
  occurrences Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([surface, subjectId, event])
  @@index([event, firstSeenAt])
  @@map("funnel_events")
}

enum TributeWebhookStatus {
  RECEIVED
  PROCESSING
  APPLIED
  IGNORED
  FAILED
}

model TributeWebhookEvent {
  id          String               @id @default(cuid())
  eventHash   String               @unique
  name        String
  payload     Json
  status      TributeWebhookStatus @default(RECEIVED)
  outcome     String?
  attempts    Int                  @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([name, createdAt])
  @@index([status])
  @@map("tribute_webhook_events")
}

enum TributeOrderStatus {
  PENDING
  PAID
  DUNNING
  CANCELED
  FAILED
}

model TributeOrder {
  id           String             @id @default(cuid())
  orderUuid    String             @unique
  userId       String
  telegramId   String
  plan         Plan
  billingCycle BillingCycle
  amount       Int
  currency     String
  payUrl       String
  status       TributeOrderStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, plan, billingCycle, status])
  @@map("tribute_orders")
}

model StripeWebhookEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("stripe_webhook_events")
}

model Job {
  id                            String    @id @default(cuid())
  userId                        String
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl                     String?
  sourceKey                     String?
  originalFilename              String?
  status                        JobStatus @default(PENDING)
  error                         String?
  sourceDurationSec             Int?
  processingStartedAt           DateTime?
  processingEndedAt             DateTime?
  processingMs                  Int?
  transcribeMs                  Int?
  analyzeMs                     Int?
  renderMs                      Int?
  clipsGenerated                Int       @default(0)
  estimatedTranscriptionCostUsd Float?
  estimatedAnalysisCostUsd      Float?
  estimatedComputeCostUsd       Float?
  estimatedTotalCostUsd         Float?
  sourceArtifactKey             String?
  thumbnailKey                  String?
  transcriptJson                Json?
  renderManifest                Json?
  transcription                 String?   @db.Text
  highlights                    Json?
  subtitles                     Boolean   @default(true)
  language              String?
  languageRaw           String?
  noClipsReason         NoClipsReason?
  normalizedArtifactKey String?
  /// Stamped by the retention sweep once a terminal job's redundant source
  /// copies have been dealt with. It is a TERMINATION MARKER, not a log: a job
  /// whose sourceArtifactKey equals its normalizedArtifactKey has nothing for
  /// that rule to delete, and without this column it would match the rule's
  /// selector on every hourly run for ever.
  sourceSweptAt         DateTime?
  analyzeEngine         AnalyzeEngine?
  highlightsVersion     Int            @default(1)
  transcriptCoverage    Float?
  transcriptPartial     Boolean        @default(false)
  analysisInputTokens   Int?
  analysisOutputTokens  Int?
  /// The two counts above, split by the model that actually ANSWERED - shape
  /// `{ "<model>": { inputTokens, outputTokens, requests } }`, the engine's own
  /// LlmUsage.byModel stored as written. It exists because dollars are DERIVED:
  /// the totals alone cannot be priced once a stage degrades to its fallback,
  /// because then the model that answered is not the model the config named, and
  /// criticModel below records only the CONFIGURED one. Pricing the aggregate at
  /// that configured rate understated job cmscht6rp001xq41s5rhjx6q0 (2026-08-03,
  /// first production job on gpt-5.6-luna, every critic batch and the finalizer
  /// re-run on gpt-5-mini) by 27-51% depending on the price table applied - and
  /// that figure is what settleFreeLedger charges against the free-tier budget.
  /// Null means "we do not know", never "one model": rows analyzed before this
  /// column, and the legacy engine, fall back to the aggregates at criticModel's
  /// rate rather than being handed an invented breakdown.
  analysisUsageByModel  Json?
  /// Which models produced the token counts and the cost figures above. Stored
  /// because dollars are DERIVED and prices move: without the multiplier, a row
  /// can never be re-priced, which is the state the ten rows predating this
  /// column are in until the backfill script runs. That backfill only works at
  /// all because the engine changed at the same time the model did - it reads
  /// analyzeEngine and date. Not a repeatable trick, which is why the column
  /// exists.
  criticModel           String?
  transcriptionModel    String?
  createdAt                     DateTime  @default(now())

  clips            Clip[]
  steps            JobStep[]
  telegramDelivery TelegramDelivery?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("jobs")
}

model JobStep {
  id         String        @id @default(cuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step       JobStepName
  status     JobStepStatus @default(PENDING)
  attempt    Int           @default(0)
  inputJson  Json?
  outputJson Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([jobId, step])
  @@index([status, step])
  @@index([jobId])
  @@map("job_steps")
}

model TelegramDelivery {
  id          String                 @id @default(cuid())
  jobId       String                 @unique
  job         Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId      String
  status      TelegramDeliveryStatus @default(PENDING)
  // Pre-send failures only: the poller bumps this when a pass threw before
  // anything reached the chat, and retires the row once it reaches
  // MAX_TELEGRAM_DELIVERY_ATTEMPTS. Without a bound a row that can never
  // succeed sits in the 20-row pickup window for ever and starves everyone
  // queued behind it. Reset to 0 whenever a pass ends in a real outcome, so
  // each stage of a delivery gets its own budget.
  attempts    Int                    @default(0)
  error       String?
  deliveredAt DateTime?
  /// The live progress board's message_id in this chat, or null when the chat
  /// has no board (the submit-time send failed, or the row predates this
  /// column). Everything that touches the board treats null as "nothing to
  /// update" rather than as an error: a missing board costs the user a nicer
  /// wait, never a clip.
  progressMessageId Int?
  /// The Job.status already rendered into that message. The poller edits only
  /// when this differs from the job's current status, which is what keeps a
  /// 10-second loop from re-sending identical text for six minutes. Nullable
  /// because the board starts life as the upload acknowledgement, before any
  /// stage has run.
  progressStatus    JobStatus?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("telegram_deliveries")
}

model Clip {
  id             String    @id @default(cuid())
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  storageKey     String
  duration       Int
  startTime      Float
  endTime        Float
  subtitles      Boolean   @default(true)
  subtitleTrack  Json?
  cropPlan       Json?
  description String?
  score       Float?
  language    String?
  lowQuality  Boolean @default(false)
  hookStart   Float? // source-absolute seconds, same timeline as startTime/endTime
  hookEnd     Float? // source-absolute seconds
  payoffAt    Float? // source-absolute seconds
  clipKind    String? // TS union ClipKind in shared types
  parentClipId   String?
  parentClip     Clip?     @relation("ClipRetrim", fields: [parentClipId], references: [id])
  retrims        Clip[]    @relation("ClipRetrim")
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([expiresAt, deletedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId, score(sort: Desc)])
  @@map("clips")
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Anonymous guest traffic. One row per visitor per path per day; a reload
/// increments `hits` rather than adding a row, so the table stays the size of
/// the audience.
///
/// No raw IP is ever stored: `visitorHash` is sha256(ip + ua + a salt derived
/// from the day), so the same person cannot be followed across days.
model SiteVisit {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  visitorHash  String
  /// ISO-2 from MaxMind GeoLite2. Null when the database file is absent - a
  /// missing GeoIP file degrades the country column, never the page load.
  country      String?
  path         String
  referrerHost String?
  /// Crawlers are flagged, not dropped, so the noise ratio stays visible and
  /// the filter itself can be audited. The page counts isBot = false.
  isBot        Boolean  @default(false)
  hits         Int      @default(1)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([day, visitorHash, path])
  @@index([day, country])
  @@index([day, isBot])
  @@map("site_visits")
}

enum FreeUsageKind {
  CHARGE
  REFUND
}

/// Why a REFUND row exists. NULL on CHARGE rows.
///
/// The balance arithmetic never reads this - it stays a single group-by on
/// `kind`. It exists so the zero-clip forgiveness cap can count only the
/// forgiveness it grants. Without it the cap matches every refund row on the
/// account, including the uncapped ones we write when a job fails on our side,
/// so an account whose first job broke spends a forgiveness it never used.
enum FreeUsageReason {
  FAILED_JOB
  ZERO_CLIPS
  /// The user deleted the job before any money had left the account - PENDING
  /// or DOWNLOADING, which are the states before the TRANSCRIBE call. Its own
  /// reason rather than FAILED_JOB because nothing failed, and rather than
  /// ZERO_CLIPS because this one is uncapped: there is no farming attack to
  /// cap, since the attack needs a transcription to have happened.
  DELETED_BEFORE_SPEND
}

/// Append-only ledger of the free allowance.
///
/// It exists as its own table for one reason: deleteProject runs
/// prisma.job.delete, so anything counted from Job rows is reset by the user
/// pressing Delete. jobId is therefore a bare string with NO relation and NO
/// cascade - a foreign key here would reintroduce that hole through the back
/// door. Rows are never updated except to true up estimatedCostUsd, and never
/// deleted.
model FreeUsage {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String?
  kind             FreeUsageKind
  reason           FreeUsageReason?
  seconds          Int
  estimatedCostUsd Float?
  createdAt        DateTime         @default(now())

  /// One charge per job and one refund per job are both genuine invariants, so
  /// this states a truth rather than imposing a rule. It is also the only thing
  /// that actually stops a double refund: two finalizes of the same job can both
  /// pass a read-check and both insert, leaving the account holding more free
  /// seconds than the tier grants. Postgres does not collide NULLs in a unique
  /// index, so rows with a NULL jobId stay unconstrained - correct, since
  /// nothing writes those today and a future manual adjustment should not be
  /// limited to one per account.
  @@unique([userId, jobId, kind])
  @@index([userId])
  @@index([createdAt])
  @@index([jobId])
  @@map("free_usage")
}
