# Dependencies
node_modules/

# Environment
# Every .env* EXCEPT the committed template. The two exact patterns that used to
# be here left a hand-made backup like `.env.bak-pre-stream` unignored, so a
# `git add -A` at the repo root would have staged live secrets.
.env*
!.env.example

# Build
dist/
.next/
out/
*.tsbuildinfo

# Prisma
prisma/*.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
pgdata/

# Temp files
tmp/
*.tmp

# Claude Code local settings
.claude/

# Superpowers tooling runtime state
.superpowers/

# Local Docker override (host-specific, e.g. linearis-prod nginx/ports)
docker-compose.override.yml
apps/worker/eval-media/

# Python bytecode (the reframe sidecar now has unit tests that import it)
__pycache__/
*.pyc

# Frame strips extracted for clip audits - regenerable, not source
apps/worker/.eval-frames*/

# Reframe corpus - materialised from assets/reframe/corpus.json, never committed
.corpus/
