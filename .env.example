# Database
DATABASE_URL=postgresql://clipclap:clipclap_dev@postgres:5432/clipclap
POSTGRES_PASSWORD=clipclap_dev

# Redis
REDIS_URL=redis://redis:6379

# Auth
NEXTAUTH_SECRET=change-me-to-random-secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_HIGHLIGHTS_MODEL=gpt-4o-mini

# --- Highlight core V2 (Recall-Judge) ---
ANALYZE_ENGINE=legacy            # legacy | recall-critic | shadow
ANALYZE_V2_PCT=0                 # 0..100 - share of jobs routed to V2; only takes effect while ANALYZE_ENGINE=legacy
OPENAI_SCAN_MODEL=gpt-4o-mini
OPENAI_CRITIC_MODEL=gpt-5.6-luna
CRITIC_MODEL_FALLBACK=gpt-5-mini

# Model prices, USD. There is deliberately no price table in the source tree -
# a compiled-in price goes stale silently (GPT-5.6 Luna was cut 80% in one day
# on 2026-07-31). Every model the engine can be pointed at needs an entry, or
# its cost is simply not recorded; the boot warning names any that are missing.
#
# The canonical table is packages/shared/src/config/model-prices.example.json,
# which is where the test reads it from. Paste its contents here as ONE line -
# this is JSON inside an env file, so a wrapped value will not parse. Run from
# the repo root:
#
#   node -e "console.log(JSON.stringify(require('./packages/shared/src/config/model-prices.example.json')))"
#
# The value is left empty here rather than duplicated, because a copy in a file
# no test can read is a copy that silently goes stale.
MODEL_PRICES_JSON=


# USD per source minute of rented capacity, for reporting only. Unset means
# compute is not reported at all, which is the honest default: the server is
# rented whether a job runs or not, so this is never money leaving the account
# because of a particular job. It is excluded from estimatedTotalCostUsd either
# way.
COMPUTE_COST_PER_MINUTE_USD=

SELECTION_REASONING_EFFORT=low
CLIP_SCORE_THRESHOLD=0.6
WEAK_FALLBACK_MIN_SCORE=0.35
SHORT_CLIP_STRICT_SEC=12          # clips shorter than this pay the score surcharge
SHORT_CLIP_SCORE_BONUS=0.15
QUESTION_END_SCORE_BONUS=0.15   # clips ending on a question pay this surcharge
CLIP_SOFT_CAP=12
CLIP_HARD_MIN_SEC=6
CLIP_TARGET_MIN_SEC=8
CLIP_MAX_SEC=90
SCAN_WINDOW_SEC=600
SCAN_OVERLAP_SEC=90
CRITIC_BATCH_SIZE=6
CRITIC_MAX_CANDIDATES=40
PER_WINDOW_MIN_CANDIDATES=2
REGION_MAX_CANDIDATES=6
ANALYZE_MAX_CONCURRENCY=5
MAX_START_EXPANSION_SEC=6
GAP_SENTENCE=0.60
GAP_PHRASE=0.30
NODE_MAX_SEC=12
LEAD_IN_SEC=0.15
TAIL_HOLD_SEC=0.30
PAYOFF_MAX_TAIL_SEC=4

# End extension - the only stage that lets a model move a shipped boundary, and
# it may only ever move an END, only FORWARD. Ships dark until the eval numbers
# justify it; `on` is an exact literal, so a typo leaves it off.
END_EXTENSION=off                # off | on
# 25 is a STARTING VALUE, not a measurement - it is the knob most likely to be
# tuned, and eval-end-audit.ts is how to move it with evidence.
END_EXTENSION_WINDOW_SEC=25      # how far past the current end it may reach
# Hint-driven half of end extension (spec 2026-08-10 task 4) - independent of
# END_EXTENSION above. Adds clips to the offered set because ARC_AUDIT's gated
# exit.fixEndNode named a completing line, and renders that pointer as a note
# in the prompt; the model still decides. No-ops without ARC_AUDIT=on too.
END_EXTENSION_HINTS=off          # off | on
# A silent hole this long between two sentences is a cut to another scene, and
# nothing may be extended across one. MEASURED on all four eval fixtures, not
# guessed - re-measure before moving it (analyze-v2/scene-gaps.ts).
SCENE_GAP_SEC=5
WHISPER_CHUNK_SEC=1200
TRANSCRIPT_MIN_COVERAGE=0.9

# --- Smart reframe (scene-aware face crop) ---
REFRAME_ENGINE=off               # off | faces
REFRAME_SAMPLE_FPS=2
REFRAME_SCENE_THRESHOLD=0.3      # scdet scene score cut (0..1); zero-cut long windows retry at half
REFRAME_MIN_SHOT_SEC=1.0
REFRAME_FACE_MIN_SCORE=0.7
REFRAME_MAX_DETECT_SEC=30

# Smart reframe - stream layout (spec 2026-08-02). Classification and telemetry
# run regardless; REFRAME_STREAM=on is what actually changes the picture.
REFRAME_STREAM=off
REFRAME_CAM_SHARE=0.40
REFRAME_FACE_SMALL_FRAC=0.06
REFRAME_FACE_LARGE_FRAC=0.10
REFRAME_PIP_MAX_FRAC=0.50
REFRAME_PIP_EDGE_MIN=4.0

# Smart reframe - crop-window motion. Off by default, and only the exact
# literal "on" turns it on: a killswitch that can be flipped by "true", "1" or
# "ON" is not one. Off means every plan is the static window that ships today.
# The four REFRAME_CAM_* knobs below are PROVISIONAL - they have no corpus
# support yet, and their first real values come from watching corpus renders.
# Do not tune them from intuition.
REFRAME_MOTION=off
REFRAME_CAM_DEADZONE=0.12        # drift, as a fraction of crop width, before the window moves
REFRAME_CAM_SETTLE=0.04          # drift it must reach before the window stops; the gap to deadzone IS the hysteresis
REFRAME_CAM_MAX_SPEED=0.25       # crop widths per second the window may travel
REFRAME_CAM_MAX_KEYFRAMES=200    # over this, the shot falls back to its static x rather than truncating

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipclap
R2_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Subscription price IDs (one per plan × cycle)
STRIPE_STARTER_WEEKLY_PRICE_ID=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_MAX_MONTHLY_PRICE_ID=

# One-time top-up price IDs
STRIPE_TOPUP_SMALL_PRICE_ID=
STRIPE_TOPUP_LARGE_PRICE_ID=

# Telegram (post-MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_WEBHOOK_URL=
# Self-hosted Bot API server (lifts 20 MB → 2 GB file download limit)
# Get from https://my.telegram.org/apps (your personal Telegram account)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Tribute (Telegram payments for RU/EU)
TRIBUTE_API_KEY=
# Base URL for the Tribute Shop API (override only for testing)
TRIBUTE_API_BASE=https://tribute.tg/api/v1

# Referral program
# Comma-separated Telegram IDs allowed to run admin CRM commands (/payouts, /approve, etc.)
REFERRAL_ADMIN_TELEGRAM_IDS=
# Public base URL + bot name used to build referral links on the web dashboard
NEXT_PUBLIC_APP_URL=https://clipclap.io
NEXT_PUBLIC_BOT_NAME=ClipClapBot
# (TELEGRAM_BOT_USERNAME above is also used by the bot's /referral link builder)

# Telegram chat id that receives in-bot support tickets (defaults to the first
# REFERRAL_ADMIN_TELEGRAM_IDS entry). Must be a PRIVATE chat.
SUPPORT_CHAT_ID=

# Shared secret between the Edge middleware and /api/track. Without it the
# tracking endpoint would be a public row-writer. Any random string.
TRACK_SECRET=
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
# Owner's own accounts (emails and/or telegram ids, comma separated), excluded
# from the "external" figures on /admin so his own testing does not read as
# traction.
ANALYTICS_OWN_ACCOUNTS=
# Bare host (no scheme) used to recognise our own referrers so we don't count
# our own pages as external traffic. Defaults to clipclap.io if unset.
NEXT_PUBLIC_APP_HOST=clipclap.io
# MaxMind licence key, used at image build time to fetch GeoLite2-Country.
# Absent = visits are still recorded, country is null.
MAXMIND_LICENSE_KEY=
GEOLITE2_COUNTRY_DB=/app/geoip/GeoLite2-Country.mmdb

# The storage retention sweep deletes R2 objects irreversibly, so it is opt-in,
# not opt-out: unset or empty means it reports what it WOULD delete and touches
# neither R2 nor the database. Set it to any non-empty value to make the
# deletes real. Name the variable for the destructive branch on purpose - a
# typo or a half-filled .env must land on "report", never on "delete".
RETENTION_SWEEP_LIVE=

# The free-allowance refund sweep returns the minutes of free jobs that failed
# in a stage finalize never sees. Its flag points the OPPOSITE way to the one
# above, and for the same reasoning applied to the opposite risk: retention
# deletes user data, so it fails closed; here the dangerous branch is NOT
# running, because a sweep silently switched off means keeping an allowance
# that is not ours. So this names the DISABLED branch and the sweep fails open
# - unset, empty or absent all RUN it. Set it to any non-empty value only to
# stop the refunds deliberately.
FREE_REFUND_SWEEP_DISABLED=

# Transactional email (Resend). Without RESEND_API_KEY nothing is sent and
# registration still works - the account is simply created unverified.
RESEND_API_KEY=
EMAIL_FROM="ClipClap <hello@clipclap.io>"

# Monthly ceiling for everything the free plan spends, in USD. 0 or unset means
# the free plan is off - that is also the rollback switch, and it needs no
# deploy. At 0.57 USD per free account, 50 funds about 90 new people a month.
# Anything that is not a positive finite number (empty, "abc", "50,00", "-5",
# "1e999") is read as 0, because the failure direction here has to be "no free
# tier" and never "unlimited free tier".
FREE_TIER_MONTHLY_BUDGET_USD=0
# Tribute pending-order reconciliation: "true" enables DB writes (grant/fail/expire).
# Leave empty for dry-run (logs only). Enable after verifying a live test purchase.
TRIBUTE_RECONCILE_LIVE=

# ---------------------------------------------------------------------------
# yt-dlp egress: Cloudflare WARP
# ---------------------------------------------------------------------------
# YouTube refuses this host's datacenter address outright ("Sign in to confirm
# you're not a bot"), on IPv4 and IPv6 alike. Player clients, PO tokens, a real
# JS runtime, the Invidious fallback and a newer yt-dlp were all measured and
# failed; routing yt-dlp through WARP is what worked.
#
# KILL SWITCH: clear this and recreate the containers to go back to direct
# egress with no code change. Empty means "no proxy", which is the pre-WARP
# behaviour exactly - and with it URL submissions to YouTube will fail again.
YTDLP_PROXY=socks5://warp:1080
# WARP exits are SHARED Cloudflare addresses, so one can pick up the bot check
# through no fault of ours. On that specific failure - and no other - the two
# yt-dlp call sites ask this control server for a new exit and retry ONCE.
# Empty disables rotation while leaving the proxy itself in place.
WARP_CONTROL_URL=http://warp:8080

# Largest clip the bot will upload to Telegram, in bytes. Checked against R2's
# reported size BEFORE any bytes are read, so an absurd file is refused rather
# than buffered. CLIP_MAX_SEC caps a clip's DURATION, not its size - the encoder
# is CRF-based, so bytes per second are set by the content and nothing else
# bounds them. Raise this only alongside the bot container's memory headroom.
TELEGRAM_UPLOAD_MAX_BYTES=262144000
