# Database
DATABASE_URL=postgresql://clipclap:clipclap_dev@postgres:5432/clipclap
POSTGRES_PASSWORD=clipclap_dev

# Redis
REDIS_URL=redis://redis:6379

# Auth
NEXTAUTH_SECRET=change-me-to-random-secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_HIGHLIGHTS_MODEL=gpt-4o-mini

# --- Highlight core V2 (Recall-Judge) ---
ANALYZE_ENGINE=legacy            # legacy | recall-critic | shadow
ANALYZE_V2_PCT=0                 # 0..100, hash(jobId) bucketing when engine=legacy
OPENAI_SCAN_MODEL=gpt-4o-mini
OPENAI_CRITIC_MODEL=gpt-5.1
CRITIC_MODEL_FALLBACK=gpt-5-mini
SELECTION_REASONING_EFFORT=low
CLIP_SCORE_THRESHOLD=0.6
WEAK_FALLBACK_MIN_SCORE=0.35
CLIP_SOFT_CAP=12
CLIP_HARD_MIN_SEC=6
CLIP_TARGET_MIN_SEC=8
CLIP_MAX_SEC=90
SCAN_WINDOW_SEC=600
SCAN_OVERLAP_SEC=90
CRITIC_BATCH_SIZE=6
CRITIC_MAX_CANDIDATES=40
PER_WINDOW_MIN_CANDIDATES=2
REGION_MAX_CANDIDATES=6
ANALYZE_MAX_CONCURRENCY=5
MAX_START_EXPANSION_SEC=3
GAP_SENTENCE=0.60
GAP_PHRASE=0.30
NODE_MAX_SEC=12
LEAD_IN_SEC=0.15
TAIL_HOLD_SEC=0.30
PAYOFF_MAX_TAIL_SEC=4
WHISPER_CHUNK_SEC=1200
TRANSCRIPT_MIN_COVERAGE=0.9

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipclap
R2_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Subscription price IDs (one per plan × cycle)
STRIPE_STARTER_WEEKLY_PRICE_ID=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_MAX_MONTHLY_PRICE_ID=

# One-time top-up price IDs
STRIPE_TOPUP_SMALL_PRICE_ID=
STRIPE_TOPUP_LARGE_PRICE_ID=

# Telegram (post-MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_WEBHOOK_URL=
# Self-hosted Bot API server (lifts 20 MB → 2 GB file download limit)
# Get from https://my.telegram.org/apps (your personal Telegram account)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Tribute (Telegram payments for RU/EU)
TRIBUTE_API_KEY=
TRIBUTE_PRODUCT_STARTER_WEEKLY_ID=
TRIBUTE_PRODUCT_STARTER_MONTHLY_ID=
TRIBUTE_PRODUCT_PLUS_MONTHLY_ID=
TRIBUTE_PRODUCT_MAX_MONTHLY_ID=
# Human-readable product names - fallback mapping when web_app_link is absent.
# REQUIRED in production (startup validation fails without them).
TRIBUTE_PRODUCT_STARTER_WEEKLY_NAME=Starter Weekly
TRIBUTE_PRODUCT_STARTER_MONTHLY_NAME=Starter Monthly
TRIBUTE_PRODUCT_PLUS_MONTHLY_NAME=Plus Monthly
TRIBUTE_PRODUCT_MAX_MONTHLY_NAME=Max Monthly
TRIBUTE_PRODUCT_STARTER_WEEKLY_URL=
TRIBUTE_PRODUCT_STARTER_MONTHLY_URL=
TRIBUTE_PRODUCT_PLUS_MONTHLY_URL=
TRIBUTE_PRODUCT_MAX_MONTHLY_URL=

# Referral program
# Comma-separated Telegram IDs allowed to run admin CRM commands (/payouts, /approve, etc.)
REFERRAL_ADMIN_TELEGRAM_IDS=
# Public base URL + bot name used to build referral links on the web dashboard
NEXT_PUBLIC_APP_URL=https://clipclap.io
NEXT_PUBLIC_BOT_NAME=ClipClapBot
# (TELEGRAM_BOT_USERNAME above is also used by the bot's /referral link builder)
