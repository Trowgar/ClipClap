{
  "name": "@clipclap/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js", "default": "./dist/index.js" },
    "./lib/*": { "types": "./dist/lib/*.d.ts", "require": "./dist/lib/*.js", "default": "./dist/lib/*.js" },
    "./config/*": { "types": "./dist/config/*.d.ts", "require": "./dist/config/*.js", "default": "./dist/config/*.js" }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/shared/src",
    "test:watch": "vitest --root ../.. packages/shared/src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "@prisma/client": "5.20.0",
    "bullmq": "^5.30.0",
    "ioredis": "^5.4.0",
    "openai": "^4.80.0",
    "resend": "^4.0.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "prisma": "5.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
